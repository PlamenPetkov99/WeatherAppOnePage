{% extends 'base.html.twig' %}

{% block title %}
    Dashboard - SkyCast
{% endblock %}

{% block body %}

    <div class="dashboard-wrapper">

        <div class="dashboard-hero">

            <div class="dashboard-hero-content">

                <h1>

                    {{ ux_icon('lucide:layout-dashboard', {
                        class: 'dashboard-title-icon'
                    }) }}

                    Personal Dashboard

                </h1>

                <p>

                    Welcome back,
                    <strong>{{ app.user.names ?? app.user.email }}</strong>

                </p>

                <span class="dashboard-subtitle">

            Your personal weather workspace.

        </span>

            </div>


        </div>

        <div class="dashboard-stats">

            <div class="dashboard-stat-card">

                {{ ux_icon('lucide:star', {
                    class: 'dashboard-stat-icon'
                }) }}

                <span class="dashboard-stat-value">

                12

            </span>

                <span class="dashboard-stat-label">

                Saved Cities

            </span>

            </div>

            <div class="dashboard-stat-card">

                {{ ux_icon('lucide:map-pin', {
                    class: 'dashboard-stat-icon'
                }) }}

                <span class="dashboard-stat-value">

                {{ ipLocationViewModel.city }}

            </span>

                <span class="dashboard-stat-label">

                Current Location

            </span>

            </div>

            <div class="dashboard-stat-card">

                {{ ux_icon('lucide:clock-3', {
                    class: 'dashboard-stat-icon'
                }) }}

                <span class="dashboard-stat-value">

                {{ ipLocationViewModel.timezone }}

            </span>

                <span class="dashboard-stat-label">

                Time Zone

            </span>

            </div>

            <div class="dashboard-stat-card">

                {{ ux_icon('lucide:map-pinned', {
                    class: 'dashboard-stat-icon'
                }) }}

                <span class="dashboard-stat-value">

                {{ ipLocationViewModel.countryName }}

            </span>

                <span class="dashboard-stat-label">

                Country Name

            </span>

            </div>

        </div>

        <div class="dashboard-main-grid">

            <div class="dashboard-panel">

                <div class="dashboard-panel-header">

                    <h2>

                        {{ ux_icon('lucide:map-pin') }}

                        Saved Cities

                    </h2>

                </div>

                <div class="saved-cities">

                    <div class="city-card">

                        <div>

                            <h3>Sofia</h3>
                            <span>COUNTRY NAME</span>
                        </div>

                        <a href="#" class="city-button ">

                            View

                        </a>

                    </div>



                </div>

            </div>

            <div class="dashboard-panel">

                <h2>

                    {{ ux_icon('lucide:settings-2') }}

                    Weather Preferences

                </h2>

                <p class="dashboard-panel-description">

                    Customize how weather information is displayed throughout SkyCast.

                </p>

                <form>

                    <div class="form-group">

                        <label for="temperature">

                            Temperature Unit

                        </label>

                        <select id="temperature">

                            <option selected>

                                Celsius (°C)

                            </option>

                            <option>

                                Fahrenheit (°F)

                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label for="wind">

                            Wind Speed

                        </label>

                        <select id="wind">

                            <option selected>

                                km/h

                            </option>

                            <option>

                                mph

                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label for="time">

                            Time Format

                        </label>

                        <select id="time">

                            <option selected>

                                24-hour

                            </option>

                            <option>

                                12-hour

                            </option>

                        </select>

                    </div>

                    <button
                        class="auth-button"
                        type="submit"
                    >

                        {{ ux_icon('lucide:save', {
                            class: 'button-icon'
                        }) }}

                        <span>

                        Save Preferences

                    </span>

                    </button>

                </form>

            </div>

        </div>

    </div>

{% endblock %}
