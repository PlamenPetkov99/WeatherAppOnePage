<div class="dashboard-weather-card">

    <div class="dashboard-weather-header">

        <div class="dashboard-weather-location">

            {{ ux_icon('lucide:map-pin', {
                class: 'city-icon'
            }) }}

            <span>
                {{ ipLocationViewModel.city }},
                {{ ipLocationViewModel.countryName }}
            </span>

        </div>

    </div>


    <div class="dashboard-weather-main">

        <div class="dashboard-weather-temperature">

            {{ weather.currentWeatherDto.temperature|number_format(1) }}
            {{ weather.currentWeatherUnitsDto.temperatureUnit }}

        </div>


        <div class="dashboard-weather-description">

            {{ weather.currentWeatherDto.description }}

        </div>

    </div>


    <div class="dashboard-weather-meta">

        <div class="weather-meta-item">

            {{ ux_icon('lucide:wind', {
                class: 'meta-icon'
            }) }}

            <span>
                {{ weather.currentWeatherDto.windSpeed }}
                {{ weather.currentWeatherUnitsDto.windSpeedUnit }}
            </span>

        </div>


        <div class="weather-meta-item">

            {{ ux_icon('lucide:droplets', {
                class: 'meta-icon'
            }) }}

            <span>
                {{ weather.currentWeatherDto.relativeHumidity }}
                {{ weather.currentWeatherUnitsDto.relativeHumidityUnit }}
            </span>

        </div>


        <div class="weather-meta-item">

            {{ ux_icon('lucide:thermometer', {
                class: 'meta-icon'
            }) }}

            <span>
                {{ weather.currentWeatherDto.apparentTemperature|number_format(1) }}
                {{ weather.currentWeatherUnitsDto.temperatureUnit }}
            </span>

        </div>

    </div>

</div>
