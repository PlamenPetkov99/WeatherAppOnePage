{% extends 'base.html.twig' %}

{% block title %}
    Login - SkyCast
{% endblock %}


{% block body %}

    <div class="auth-wrapper">

        <div class="auth-card">

            <h1>
                Welcome back 🌤️
            </h1>

            <p class="auth-subtitle">
                Login to your SkyCast account
            </p>


            {{ form_start(form) }}


                <div class="form-group">

                    {{ form_label(form.email) }}

                    {{ form_widget(form.email) }}

                    {{ form_errors(form.email) }}

                </div>

                <div class="form-group">

                    {{ form_label(form.password) }}

                    {{ form_widget(form.password) }}

                    {{ form_errors(form.password) }}

                </div>

                <div class="form-global-error">
                    {{ form_errors(form) }}
                </div>

            <div class="remember-me">

                {{ form_widget(form.rememberMe) }}

                {{ form_label(form.rememberMe) }}

            </div>

            {{ form_errors(form.rememberMe) }}

            {{ form_widget(form.login, {
                label_html: true,
                label: ux_icon('lucide:corner-down-left') ~ ' Login'
            }) }}

            <a href="{{ path('app_index') }}" class="auth-secondary-button">
                {{ ux_icon('lucide:move-left', {
                    class: 'nav-icon'
                }) }} Back to home
            </a>

            {{ form_end(form) }}


            <p class="auth-footer">

                Don't have an account?

                <a href="{{ path(name: 'app_register') }}">
                    Register
                </a>

            </p>


        </div>

    </div>


{% endblock %}
