{% extends 'base.html.twig' %}

{% block title %}
    Backup Code Authentication - SkyCast
{% endblock %}

{% block body %}


    <div class="auth-wrapper">

        <div class="auth-card auth-card-2fa">

            <div class="auth-icon">🔑</div>

            <h1>Backup Code</h1>

            <p class="auth-subtitle">
                Enter one of your backup codes to continue.
            </p>

            {% if authenticationError is defined and authenticationError %}
                <div class="form-global-error">
                    {{ authenticationError|trans({}, 'SchebTwoFactorBundle') }}
                </div>
            {% endif %}

            <form method="post" action="/2fa_check">

                <div class="form-group">

                    <label for="code">
                        Backup code
                    </label>

                    <input
                        id="code"
                        name="code"
                        type="text"
                        class="auth-code-input"
                        placeholder="XXXXXXXXXX"
                        autocomplete="off"
                        required
                        autofocus
                    >

                </div>

                {% if isCsrfProtectionEnabled is defined and isCsrfProtectionEnabled %}
                    <input
                        type="hidden"
                        name="{{ csrfParameterName }}"
                        data-controller="csrf-protection"
                        value="{{ csrf_token(csrfTokenId) }}"
                    >
                {% endif %}

                {% if displayTrustedOption is defined and displayTrustedOption %}
                    <div class="form-group-checkbox">

                        <label>
                            <input
                                type="checkbox"
                                name="_trusted"
                            >

                            Trust this device
                        </label>

                    </div>
                {% endif %}

                <button
                    type="submit"
                    class="auth-button"
                >
                    {{ ux_icon('lucide:corner-down-left', {
                        class: 'nav-icon'
                    }) }}

                    Verify backup code
                </button>

            </form>

            <form method="post" action="{{ path('app_logout') }}" style="display:contents;">
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                <button type="submit" class="auth-secondary-button">
                    {{ ux_icon('lucide:move-left', {
                        class: 'nav-icon'
                    }) }}

                    Cancel and log out
                </button>
            </form>

            <div class="auth-help">

                <p>
                    Backup codes are one-time codes that can be used
                    if you don't have access to your authenticator app.
                </p>

                <p class="auth-help-small">
                    Each backup code can only be used once.
                </p>

            </div>

        </div>

    </div>


{% endblock %}
